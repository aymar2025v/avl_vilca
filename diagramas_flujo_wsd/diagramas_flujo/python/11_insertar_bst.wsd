@startuml 11_insertar_bst
skinparam shadowing false
skinparam ActivityBackgroundColor #F4F7FB
skinparam ActivityBorderColor #1F3A5F
skinparam ArrowColor #1F3A5F
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C8553D
skinparam ActivityDiamondBackgroundColor #FFF3E0
skinparam ActivityDiamondBorderColor #1F3A5F
skinparam PartitionBorderColor #1F3A5F
skinparam ActivityStartColor #1F3A5F
skinparam ActivityEndColor #1F3A5F

title insertar_bst(raiz, clave) - insercion en un BST sin balanceo (avl_python.py lineas 118 a 126)

start
:Entrada: raiz (un Nodo o None) y clave;
note right
  Igual que insertar_avl pero SIN reequilibrar.
  Se usa en el experimento para comparar alturas.
end note
if (Linea 120: raiz is None ?) then (si, hueco encontrado)
  #C8E6C9:Linea 121: return Nodo(clave)\nSE CREA UN OBJETO Nodo nuevo\nvalor toma None por defecto\nver diagrama 01_Nodo_init;
  stop
else (no)
endif
if (Linea 122: clave menor que raiz.clave ?) then (si)
  :Linea 123: raiz.izq = insertar_bst(raiz.izq, clave)\nLLAMADA RECURSIVA por la izquierda;
elseif (Linea 124: clave mayor que raiz.clave ?) then (si)
  :Linea 125: raiz.der = insertar_bst(raiz.der, clave)\nLLAMADA RECURSIVA por la derecha;
else (claves iguales)
  :No se inserta nada\nla clave repetida se ignora;
endif
:Linea 126: return raiz\nno hay balancear: con claves ordenadas el arbol\nse degenera en una lista;
stop

legend bottom right
  Verde: se crea un objeto o una variable
  Rojo: se destruye un objeto o una variable
  Nota amarilla: estado de la memoria o explicacion
endlegend
@enduml
