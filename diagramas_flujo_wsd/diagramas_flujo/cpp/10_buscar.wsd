@startuml 10_buscar
skinparam shadowing false
skinparam ActivityBackgroundColor #F4F7FB
skinparam ActivityBorderColor #1F3A5F
skinparam ArrowColor #1F3A5F
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C8553D
skinparam ActivityDiamondBackgroundColor #FFF3E0
skinparam ActivityDiamondBorderColor #1F3A5F
skinparam PartitionBorderColor #1F3A5F
skinparam ActivityStartColor #1F3A5F
skinparam ActivityEndColor #1F3A5F

title buscar(raiz, clave) - busqueda en el arbol (avl.h lineas 151 a 158)

start
:Entrada: raiz (referencia constante) y clave a buscar;
note right
  Devuelve un puntero crudo NodoBST con asterisco
  que NO es dueno del nodo: el dueno sigue siendo el unique_ptr.
  No se crea ni se destruye ningun objeto.
end note
if (Linea 154: raiz == nullptr ?) then (si, llegamos a un enlace vacio)
  :return nullptr\nla clave no esta en el arbol;
  stop
else (no)
endif
if (Linea 155: clave == raiz->clave ?) then (si)
  :return raiz.get()\nget() entrega el puntero crudo sin quitarle\nla propiedad al unique_ptr;
  stop
else (no)
endif
if (Linea 156: clave menor que raiz->clave ?) then (si)
  :return buscar(raiz->izq, clave)\nLLAMADA RECURSIVA por la izquierda;
else (no, clave mayor)
  :return buscar(raiz->der, clave)\nLLAMADA RECURSIVA por la derecha;
endif
note right
  Como el arbol AVL tiene altura O(log n),
  la busqueda hace a lo sumo altura comparaciones.
end note
stop

legend bottom right
  Verde: se crea un objeto o una variable
  Rojo: se destruye un objeto o una variable
  Nota amarilla: estado de la memoria o explicacion
endlegend
@enduml
