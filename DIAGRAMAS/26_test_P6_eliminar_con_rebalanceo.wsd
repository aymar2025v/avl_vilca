@startuml 26_test_P6_eliminar_con_rebalanceo
skinparam shadowing false
skinparam ArrowColor #1F4E79
skinparam ActivityBorderColor #1F4E79
skinparam ActivityBackgroundColor #EAF2FB
skinparam ActivityDiamondBorderColor #BF9000
skinparam ActivityDiamondBackgroundColor #FFF2CC
skinparam NoteBackgroundColor #FFFBE6
skinparam NoteBorderColor #BF9000
skinparam ClassBackgroundColor #EAF2FB
skinparam ClassBorderColor #1F4E79
title test_P6_eliminar_con_rebalanceo() - insertar 1..7 y eliminar 1

start
:r = nullptr;
:i = 1;
while (i <= 7 ?) is (sí)
  :insertar_avl(r, i, i);
  :++i;
endwhile (no)
note right
  Árbol perfecto:
  <code>
          4
        /   \
       2     6
      / \   / \
     1   3 5   7
  </code>
end note
:int h_antes = h(r);
note right: h_antes = 3
:eliminar_avl(r, 1);
note right
  Se elimina la hoja 1. El nodo 2 queda solo con el hijo 3
  (fb = +1) y la raíz sigue equilibrada: no hace falta rotar.
end note
:assert(h(r) <= h_antes);
note right: la altura no aumentó tras eliminar
:std::cout << "[P6 OK] (h antes = " << h_antes << ", h despues = " << h(r) << ")";
stop
@enduml
