@startuml 07_rotar_derecha
' ---------- Estilo técnico formal (esquinas rectas) ----------
skinparam shadowing false
skinparam roundCorner 0
skinparam ActivityRoundCorner 0
skinparam defaultFontName Arial
skinparam ActivityFontName Consolas
skinparam ActivityFontSize 12
skinparam NoteFontSize 11
skinparam ArrowColor #000000
skinparam ArrowThickness 1
skinparam ActivityBorderColor #000000
skinparam ActivityBorderThickness 1.2
skinparam ActivityBackgroundColor #F2F2F2
skinparam ActivityDiamondBorderColor #000000
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityStartColor #000000
skinparam ActivityEndColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #595959
skinparam NoteBorderThickness 1
skinparam PartitionBorderColor #595959
skinparam PartitionBackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleBorderThickness 1.5
skinparam TitleBorderColor #000000
skinparam TitleBorderRoundCorner 0
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #000000
skinparam LegendBorderThickness 1
skinparam LegendBorderRoundCorner 0
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #000000
skinparam ClassAttributeIconSize 0
skinparam PackageStyle rectangle
skinparam PackageBorderColor #595959
skinparam ComponentBackgroundColor #F2F2F2
skinparam ComponentBorderColor #000000
skinparam SequenceParticipantBackgroundColor #F2F2F2
skinparam SequenceParticipantBorderColor #000000
skinparam SequenceLifeLineBorderColor #595959
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceDividerBackgroundColor #D9D9D9
skinparam FooterFontSize 9
footer SIS210 - Algoritmos y Estructuras de Datos  ·  UNAP 2026-II  ·  Semana 10: Árbol AVL  ·  Fuente: avl.h, líneas 74-83
title rotar_derecha(z): corrección del caso LL (rotación simple a la derecha)

legend top
  |= Campo |= Detalle |
  | Entrada | z: referencia al unique_ptr que apunta al nodo desbalanceado |
  | Precondición | z y z->izq no son nullptr (fb(z) = -2 y fb(z->izq) <= 0) |
  | Postcondición | El antiguo z->izq (y) es la nueva raíz del subárbol; se conserva el orden inorden; alturas actualizadas |
  | Complejidad | O(1): solo se reasignan punteros |
endlegend

start
:Entrada: z (referencia al unique_ptr del nodo desbalanceado)<
note right
  Estado inicial (z es dueño de y, y es dueño de x y T3):
  <code>
         z
        / \
       y   T4
      / \
     x   T3
  </code>
end note

partition "Fase 1: desacoplar y mover T3" {
  :[1] auto y = std::move(z->izq);
  note right
    y toma la propiedad del hijo izquierdo.
    z->izq queda en nullptr.
  end note
  :[2] z->izq = std::move(y->der);
  note right
    T3 (hijo derecho de y) pasa a ser hijo izquierdo de z.
    y->der queda en nullptr.
  end note
}
partition "Fase 2: actualizar z" {
  #DDEBF7:[3] actualizar_altura(z);
  note right
    z ya perdió a y y ganó a T3.
    Se actualiza PRIMERO z porque la altura de y depende de la de z.
  end note
}
partition "Fase 3: reubicar los nodos" {
  :[4] y->der = std::move(z);
  note right
    z (con su altura nueva) pasa a ser hijo derecho de y.
    La referencia z queda momentáneamente en nullptr.
  end note
  :[5] z = std::move(y);
  note right
    La referencia z es el "hueco" del padre (o la raíz del árbol).
    Ahora apunta a y: el padre queda enlazado a la nueva raíz sin tocarlo.
  end note
}
partition "Fase 4: cierre" {
  #DDEBF7:[6] actualizar_altura(z);
  note right: z ahora es y: altura = 1 + max(altura(x), altura del z antiguo).
  #FCE4D6:[7] ++contador_rotaciones;
}
note right
  Estado final:
  <code>
         y
       /   \
      x     z
           / \
          T3  T4
  </code>
end note
stop
@enduml
