@startuml 21_test_P1_insercion_simple
' ---------- Estilo técnico formal (esquinas rectas) ----------
skinparam shadowing false
skinparam roundCorner 0
skinparam ActivityRoundCorner 0
skinparam defaultFontName Arial
skinparam ActivityFontName Consolas
skinparam ActivityFontSize 12
skinparam NoteFontSize 11
skinparam ArrowColor #000000
skinparam ArrowThickness 1
skinparam ActivityBorderColor #000000
skinparam ActivityBorderThickness 1.2
skinparam ActivityBackgroundColor #F2F2F2
skinparam ActivityDiamondBorderColor #000000
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityStartColor #000000
skinparam ActivityEndColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #595959
skinparam NoteBorderThickness 1
skinparam PartitionBorderColor #595959
skinparam PartitionBackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleBorderThickness 1.5
skinparam TitleBorderColor #000000
skinparam TitleBorderRoundCorner 0
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #000000
skinparam LegendBorderThickness 1
skinparam LegendBorderRoundCorner 0
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #000000
skinparam ClassAttributeIconSize 0
skinparam PackageStyle rectangle
skinparam PackageBorderColor #595959
skinparam ComponentBackgroundColor #F2F2F2
skinparam ComponentBorderColor #000000
skinparam SequenceParticipantBackgroundColor #F2F2F2
skinparam SequenceParticipantBorderColor #000000
skinparam SequenceLifeLineBorderColor #595959
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceDividerBackgroundColor #D9D9D9
skinparam FooterFontSize 9
footer SIS210 - Algoritmos y Estructuras de Datos  ·  UNAP 2026-II  ·  Semana 10: Árbol AVL  ·  Fuente: avl_main.cpp, líneas 67-81
title test_P1_insercion_simple(): insertar 10, 20, 30 (caso RR)

legend top
  |= Campo |= Detalle |
  | Objetivo | Verificar que 3 claves ordenadas dan h = 2 (un BST daría h = 3) |
  | Caso | RR: una rotación simple a la izquierda |
  | Resultado esperado | Raíz 20 con hijos 10 y 30, h = 2, contador_rotaciones = 1 |
endlegend

start
partition "Preparación" {
  :[1] unique_ptr<NodoBST<int,int>> r = nullptr;
  :[2] contador_rotaciones = 0;
}
partition "Operación" {
  #DDEBF7:[3] insertar_avl(r, 10, 10);
  #DDEBF7:[4] insertar_avl(r, 20, 20);
  #FCE4D6:[5] insertar_avl(r, 30, 30);
  note right
    Al insertar 30 el nodo 10 queda con fb = +2: caso RR, rotar_izquierda.
    Antes: 10 -> 20 -> 30 (lista, h = 3)
    Después: 20 con hijos 10 y 30 (h = 2)
  end note
}
partition "Verificación" {
  #E4DFEC:[6] assert(h(r) == 2);
  #E4DFEC:[7] assert(r->clave == 20);
  #E4DFEC:[8] assert(contador_rotaciones == 1);
  note right: Una sola rotación simple.
  :[9] std::cout << "[P1 OK] ..." << contador_rotaciones>
  #DDEBF7:[10] imprimir_arbol(r);
}
stop
@enduml
